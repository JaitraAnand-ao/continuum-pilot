{
  "openapi": "3.1.0",
  "info": {
    "title": "ST-18 Email recipients (CMP-2)",
    "version": "1.0.0",
    "description": "IF-51 to IF-56, provided by CMP-2 for SCR-8. Every operation requires the config.write role. Rejections and failures are RFC 9457 problems carrying no upstream message."
  },
  "paths": {
    "/api/v1/recipients": {
      "get": {
        "operationId": "listRecipients",
        "x-interface": "IF-51",
        "responses": {
          "200": {
            "description": "The recipients; empty carries the AC-7 text",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipientList"
                }
              }
            }
          },
          "401": {
            "description": "No session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Not a report administrator (AdminOnlyProblem); the denial is audited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOnlyProblem"
                }
              }
            }
          },
          "503": {
            "description": "The recipient store cannot be read",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "checkAndAddRecipient",
        "x-interface": "IF-53",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckAndAdd"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Passed the reader-group check and sent for approval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Proposed"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Not a report administrator (AdminOnlyProblem); the denial is audited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOnlyProblem"
                }
              }
            }
          },
          "404": {
            "description": "The directory does not know the id",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Already a recipient",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Rejected by the reader-group check; nothing saved",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RejectionProblem"
                }
              }
            }
          },
          "503": {
            "description": "Check failed closed (audited, alarm raised) or the store rejected the write; nothing saved",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipients/directory": {
      "get": {
        "operationId": "searchDirectory",
        "x-interface": "IF-52",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SearchText"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectoryResults"
                }
              }
            }
          },
          "400": {
            "description": "Invalid search text",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Not a report administrator (AdminOnlyProblem); the denial is audited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOnlyProblem"
                }
              }
            }
          },
          "503": {
            "description": "Directory lookup failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipients/{id}": {
      "delete": {
        "operationId": "removeRecipient",
        "x-interface": "IF-54",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Removed at once, without approval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Announcement"
                }
              }
            }
          },
          "400": {
            "description": "Invalid id",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Not a report administrator (AdminOnlyProblem); the denial is audited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOnlyProblem"
                }
              }
            }
          },
          "404": {
            "description": "Unknown recipient",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Waiting for approval: withdraw instead",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Store rejected the write; list unchanged",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipients/{id}/proposal": {
      "delete": {
        "operationId": "withdrawRecipientProposal",
        "x-interface": "IF-55",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Proposal withdrawn",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Announcement"
                }
              }
            }
          },
          "400": {
            "description": "Invalid id",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Not a report administrator (AdminOnlyProblem); the denial is audited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOnlyProblem"
                }
              }
            }
          },
          "404": {
            "description": "Unknown recipient",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Active: remove instead",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Store rejected the write; list unchanged",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipients/audit": {
      "get": {
        "operationId": "recipientAuditTrail",
        "x-interface": "IF-56",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditTrail"
                }
              }
            }
          },
          "401": {
            "description": "No session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Not a report administrator (AdminOnlyProblem); the denial is audited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOnlyProblem"
                }
              }
            }
          },
          "503": {
            "description": "The audit trail cannot be read",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "title", "status", "traceId"],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "traceId": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          }
        }
      },
      "AdminOnlyProblem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Problem"
          }
        ],
        "properties": {
          "type": {
            "const": "/problems/admin-only"
          },
          "title": {
            "const": "Only report administrators can manage recipients."
          },
          "status": {
            "const": 403
          }
        }
      },
      "RejectionProblem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "title", "status", "traceId", "reason"],
        "properties": {
          "type": {
            "enum": [
              "/problems/recipient-not-reader",
              "/problems/recipient-group-outsiders",
              "/problems/recipient-empty-group"
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "const": 422
          },
          "traceId": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "reason": {
            "enum": ["not-reader", "group-outsiders", "empty-group"]
          },
          "outsiders": {
            "type": "object",
            "additionalProperties": false,
            "required": ["count", "total", "addresses"],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "total": {
                "type": "integer",
                "minimum": 1
              },
              "addresses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "SearchText": {
        "type": "string",
        "minLength": 2,
        "maxLength": 64,
        "pattern": "^[\\p{L}\\p{N} ._@-]+$"
      },
      "CheckAndAdd": {
        "type": "object",
        "additionalProperties": false,
        "required": ["directoryId"],
        "properties": {
          "directoryId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          }
        }
      },
      "DirectoryResults": {
        "type": "object",
        "additionalProperties": false,
        "required": ["results"],
        "properties": {
          "results": {
            "type": "array",
            "maxItems": 25,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["directoryId", "kind", "displayName", "address"],
              "properties": {
                "directoryId": {
                  "type": "string"
                },
                "kind": {
                  "enum": ["person", "group"]
                },
                "displayName": {
                  "type": "string"
                },
                "address": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Recipient": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "displayName",
          "address",
          "memberCount",
          "typeText",
          "checkText",
          "status",
          "statusText",
          "addedBy",
          "addedAt",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": ["person", "group"]
          },
          "displayName": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "memberCount": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "typeText": {
            "type": "string"
          },
          "checkText": {
            "type": "string"
          },
          "status": {
            "enum": ["active", "pending"]
          },
          "statusText": {
            "enum": ["Active", "Waiting for approval"]
          },
          "addedBy": {
            "type": "string"
          },
          "addedAt": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "label"],
            "properties": {
              "kind": {
                "enum": ["remove", "withdraw"]
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      },
      "RecipientList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recipients"],
        "properties": {
          "recipients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Recipient"
            }
          },
          "empty": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "note"],
            "properties": {
              "title": {
                "const": "Nobody receives the daily email"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      },
      "Proposed": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recipient", "announcement"],
        "properties": {
          "recipient": {
            "$ref": "#/components/schemas/Recipient"
          },
          "announcement": {
            "type": "string"
          }
        }
      },
      "Announcement": {
        "type": "object",
        "additionalProperties": false,
        "required": ["announcement"],
        "properties": {
          "announcement": {
            "type": "string"
          },
          "confirmation": {
            "type": "string"
          }
        }
      },
      "AuditTrail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["events"],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "account", "target", "at"],
              "properties": {
                "type": {
                  "enum": [
                    "recipient.checked",
                    "recipient.check_failed",
                    "recipient.proposed",
                    "recipient.removed",
                    "recipient.withdrawn"
                  ]
                },
                "account": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "outcome": {
                  "enum": ["eligible", "not-reader", "group-outsiders", "empty-group"]
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    }
  }
}
