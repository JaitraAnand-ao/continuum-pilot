{
  "openapi": "3.1.0",
  "info": {
    "title": "Entra Sign-In Reports BFF - detection settings",
    "version": "1.0.0",
    "description": "IF-40, provided by ST-15 (CMP-2). The current config version's thresholds and sensitive-app list, with the pending change per setting. pending is null until ST-16 records proposals; the shape is fixed now so ST-16 builds against it."
  },
  "paths": {
    "/api/v1/detection-settings": {
      "get": {
        "operationId": "getDetectionSettings",
        "summary": "Current detection settings",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Settings in effect.",
            "headers": { "Cache-Control": { "schema": { "type": "string", "const": "no-store" } } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["configVersionId", "thresholds", "sensitiveApps", "pendingCount"],
                  "properties": {
                    "configVersionId": { "type": "string", "format": "uuid" },
                    "pendingCount": { "type": "integer", "minimum": 0 },
                    "thresholds": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "thresholdKey",
                          "count",
                          "windowMinutes",
                          "defaultCount",
                          "defaultWindowMinutes",
                          "inEffectSince",
                          "pending"
                        ],
                        "properties": {
                          "thresholdKey": { "type": "string", "enum": ["repeated_failures", "password_spray"] },
                          "count": { "type": "integer", "minimum": 1 },
                          "windowMinutes": { "type": "integer", "minimum": 1 },
                          "defaultCount": { "type": "integer", "minimum": 1 },
                          "defaultWindowMinutes": { "type": "integer", "minimum": 1 },
                          "inEffectSince": { "type": "string", "format": "date-time" },
                          "pending": { "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/PendingRef" }] }
                        }
                      }
                    },
                    "sensitiveApps": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["appId", "appName", "addedBy", "addedAt", "pending"],
                        "properties": {
                          "appId": { "type": "string", "format": "uuid" },
                          "appName": { "type": "string" },
                          "addedBy": { "type": "string" },
                          "addedAt": { "type": "string", "format": "date-time" },
                          "pending": { "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/PendingRef" }] }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No session.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "403": {
            "description": "The session lacks config.read.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "503": {
            "description": "The settings store did not respond.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "__Host-sr_session" }
    },
    "schemas": {
      "PendingRef": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposalId", "summary", "proposedBy", "proposedAt"],
        "properties": {
          "proposalId": { "type": "string", "format": "uuid" },
          "summary": { "type": "string", "examples": ["Raise from 10 to 15"] },
          "proposedBy": { "type": "string" },
          "proposedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "title", "status", "traceId"],
        "properties": {
          "type": { "type": "string", "format": "uri-reference" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "traceId": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
        }
      }
    }
  }
}
