          "name": "email_recipient_member_count_matches_kind",
          "value": "CASE \"email_recipient\".\"kind\" WHEN 'group' THEN coalesce(\"email_recipient\".\"member_count\" >= 1, false) ELSE \"email_recipient\".\"member_count\" IS NULL END"
        },
        "email_recipient_address_shape": {
