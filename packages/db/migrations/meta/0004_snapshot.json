          "value": "\"email_recipient\".\"address\" ~ '^[^@[:space:]]+@[^@[:space:]]+$'"
        },
        "email_recipient_status_matches_approval": {
          "name": "email_recipient_status_matches_approval",
          "value": "CASE \"email_recipient\".\"status\" WHEN 'active' THEN \"email_recipient\".\"approved_by_oid\" IS NOT NULL AND \"email_recipient\".\"approved_by_name\" IS NOT NULL AND \"email_recipient\".\"approved_at\" IS NOT NULL ELSE \"email_recipient\".\"approved_by_oid\" IS NULL AND \"email_recipient\".\"approved_by_name\" IS NULL AND \"email_recipient\".\"approved_at\" IS NULL END"
