          "value": "(\"report\".\"status\" = 'complete') = (cardinality(\"report\".\"missing_sources\") = 0)"
        },
        "report_counts_non_negative": {
          "name": "report_counts_non_negative",
          "value": "\"report\".\"successful\" >= 0 AND \"report\".\"failed\" >= 0"
        },
        "report_total_is_successful_plus_failed": {
          "name": "report_total_is_successful_plus_failed",
          "value": "\"report\".\"total\" = \"report\".\"successful\" + \"report\".\"failed\""
        },
        "report_total_matches_snapshot": {
          "name": "report_total_matches_snapshot",
          "value": "CASE WHEN jsonb_typeof(\"report\".\"snapshot\" -> 'signIns') = 'array' THEN jsonb_array_length(\"report\".\"snapshot\" -> 'signIns') = \"report\".\"total\" ELSE false END"
        },
