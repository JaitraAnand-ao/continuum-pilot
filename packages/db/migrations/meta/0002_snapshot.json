        "report_window_is_utc_day": {
          "name": "report_window_is_utc_day",
          "value": "\"report\".\"window_start\" = (\"report\".\"report_date\"::timestamp AT TIME ZONE 'UTC') AND \"report\".\"window_end\" = ((\"report\".\"report_date\" + 1)::timestamp AT TIME ZONE 'UTC')"
        },
