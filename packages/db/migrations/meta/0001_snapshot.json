      "indexes": {},
      "foreignKeys": {},
      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "policies": {},
      "checkConstraints": {
        "report_window_is_the_utc_day": {
          "name": "report_window_is_the_utc_day",
          "value": "\"report\".\"window_start\" = (\"report\".\"report_date\"::timestamp AT TIME ZONE 'UTC') AND \"report\".\"window_end\" = \"report\".\"window_start\" + interval '1 day'"
        },
        "report_status_known": {
          "name": "report_status_known",
          "value": "\"report\".\"status\" IN ('complete', 'incomplete')"
        },
        "report_missing_sources_known": {
          "name": "report_missing_sources_known",
          "value": "\"report\".\"missing_sources\" <@ ARRAY['signIns.interactiveUser', 'signIns.nonInteractiveUser', 'signIns.servicePrincipal', 'signIns.managedIdentity', 'identityProtection.riskDetections']::text[]"
        },
        "report_complete_iff_nothing_missing": {
          "name": "report_complete_iff_nothing_missing",
          "value": "(\"report\".\"status\" = 'complete') = (cardinality(\"report\".\"missing_sources\") = 0)"
        },
        "report_totals_add_up": {
          "name": "report_totals_add_up",
          "value": "\"report\".\"successful\" >= 0 AND \"report\".\"failed\" >= 0 AND \"report\".\"total\" = \"report\".\"successful\" + \"report\".\"failed\""
        },
        "report_snapshot_shape": {
          "name": "report_snapshot_shape",
          "value": "coalesce(jsonb_typeof(\"report\".\"snapshot\" -> 'signIns') = 'array' AND jsonb_typeof(\"report\".\"snapshot\" -> 'riskDetections') = 'array', false)"
        },
        "report_content_hash_sha256_hex": {
          "name": "report_content_hash_sha256_hex",
          "value": "\"report\".\"content_hash\" ~ '^[0-9a-f]{64}$'"
        },
        "report_published_after_window": {
          "name": "report_published_after_window",
          "value": "\"report\".\"published_at\" >= \"report\".\"window_end\""
        }
      },
      "isRLSEnabled": false
    },
