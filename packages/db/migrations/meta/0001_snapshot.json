      "checkConstraints": {
        "reports_window_is_the_utc_day": {
          "name": "reports_window_is_the_utc_day",
          "value": "\"reports\".\"window_start\" = (\"reports\".\"report_date\"::timestamp AT TIME ZONE 'UTC') AND \"reports\".\"window_end\" = \"reports\".\"window_start\" + interval '1 day'"
        },
        "reports_counts_reconcile": {
          "name": "reports_counts_reconcile",
          "value": "\"reports\".\"successful_count\" >= 0 AND \"reports\".\"failed_count\" >= 0 AND \"reports\".\"total_count\" = \"reports\".\"successful_count\" + \"reports\".\"failed_count\""
        },
        "reports_content_hash_is_sha256": {
          "name": "reports_content_hash_is_sha256",
          "value": "\"reports\".\"content_hash\" ~ '^[0-9a-f]{64}$'"
        },
        "reports_status_matches_contents": {
          "name": "reports_status_matches_contents",
          "value": "(\"reports\".\"status\" = 'complete' AND cardinality(\"reports\".\"missing_sources\") = 0 AND \"reports\".\"content_hash\" IS NOT NULL AND \"reports\".\"published_at\" IS NOT NULL)\n       OR (\"reports\".\"status\" = 'incomplete' AND cardinality(\"reports\".\"missing_sources\") > 0 AND \"reports\".\"content_hash\" IS NOT NULL AND \"reports\".\"published_at\" IS NOT NULL)\n       OR (\"reports\".\"status\" = 'not_generated' AND cardinality(\"reports\".\"missing_sources\") > 0 AND \"reports\".\"content_hash\" IS NULL AND \"reports\".\"published_at\" IS NULL AND \"reports\".\"total_count\" = 0)"
        }
      },
