      "checkConstraints": {
        "report_not_generated_missing_sources_known": {
          "name": "report_not_generated_missing_sources_known",
          "value": "cardinality(\"report_not_generated\".\"missing_sources\") > 0 AND \"report_not_generated\".\"missing_sources\" <@ ARRAY['signIns.interactiveUser', 'signIns.nonInteractiveUser', 'signIns.servicePrincipal', 'signIns.managedIdentity', 'identityProtection.riskDetections']::text[]"
        },
        "report_not_generated_after_day": {
          "name": "report_not_generated_after_day",
          "value": "\"report_not_generated\".\"recorded_at\" >= ((\"report_not_generated\".\"report_date\" + 1)::timestamp AT TIME ZONE 'UTC')"
        }
      },
      "isRLSEnabled": false
    }
