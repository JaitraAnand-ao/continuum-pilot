          "value": "\"session\".\"last_seen_at\" >= \"session\".\"created_at\""
        },
        "session_idle_at_most_15_minutes": {
          "name": "session_idle_at_most_15_minutes",
          "value": "\"session\".\"idle_expires_at\" <= least(\"session\".\"absolute_expires_at\", \"session\".\"last_seen_at\" + interval '15 minutes')"
        },
        "session_end_reason_known": {
