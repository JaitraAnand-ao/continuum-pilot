        "session_absolute_at_most_8_hours": {
          "name": "session_absolute_at_most_8_hours",
          "value": "\"session\".\"absolute_expires_at\" <= \"session\".\"created_at\" + interval '8 hours'"
        },
        "session_last_seen_after_created": {
