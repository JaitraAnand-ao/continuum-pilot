{
  "name": "continuum-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "Entra Sign-In Reports — scaffold from the approved step-10 plan (v4). Each package is one component's home; the gate scripts below are what CI runs, one per definition-of-done gate.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "testing/*"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "scan": "npm audit --omit=dev --audit-level=high",
    "check:trace": "node scripts/check-trace.mjs",
    "test:axe": "node scripts/test-axe.mjs",
    "check:keyboard-pass": "node scripts/check-keyboard-pass.mjs",
    "test:contracts": "node scripts/check-contracts.mjs",
    "openapi": "node scripts/generate-openapi.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "scan:image": "node scripts/scan-image.mjs",
    "certs:local": "node scripts/certs-local.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@stoplight/prism-cli": "^5.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
