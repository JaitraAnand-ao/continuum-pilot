{
  "resource": {
    "aws_security_group": {
      "alb": {
        "//": "Rules are separate aws_vpc_security_group_*_rule resources; no inline ingress or egress.",
        "name": "${var.name_prefix}-edge",
        "description": "Edge ALB: HTTPS 443 from the internet, re-encrypted to the api and Keycloak tasks",
        "vpc_id": "${var.vpc_id}"
      }
    },
    "aws_vpc_security_group_ingress_rule": {
      "https": {
        "for_each": "${toset(var.ingress_cidrs)}",
        "security_group_id": "${aws_security_group.alb.id}",
        "description": "HTTPS listener",
        "cidr_ipv4": "${each.value}",
        "ip_protocol": "tcp",
        "from_port": 443,
        "to_port": 443
      }
    },
    "aws_vpc_security_group_egress_rule": {
      "api": {
        "security_group_id": "${aws_security_group.alb.id}",
        "description": "Re-encrypted traffic to the api",
        "referenced_security_group_id": "${var.api_security_group_id}",
        "ip_protocol": "tcp",
        "from_port": "${var.api_port}",
        "to_port": "${var.api_port}"
      },
      "keycloak": {
        "security_group_id": "${aws_security_group.alb.id}",
        "description": "Re-encrypted traffic to Keycloak",
        "referenced_security_group_id": "${var.keycloak_security_group_id}",
        "ip_protocol": "tcp",
        "from_port": "${var.keycloak_port}",
        "to_port": "${var.keycloak_port}"
      },
      "keycloak_health": {
        "security_group_id": "${aws_security_group.alb.id}",
        "description": "Keycloak management health checks",
        "referenced_security_group_id": "${var.keycloak_security_group_id}",
        "ip_protocol": "tcp",
        "from_port": "${var.keycloak_management_port}",
        "to_port": "${var.keycloak_management_port}"
      }
    },
    "aws_lb": {
      "edge": {
        "name": "${var.name_prefix}-edge",
        "load_balancer_type": "application",
        "internal": false,
        "subnets": "${var.public_subnet_ids}",
        "security_groups": ["${aws_security_group.alb.id}"],
        "drop_invalid_header_fields": true,
        "desync_mitigation_mode": "strictest",
        "enable_deletion_protection": true,
        "access_logs": [
          {
            "bucket": "${var.access_logs_bucket}",
            "prefix": "edge",
            "enabled": true
          }
        ]
      }
    },
    "aws_lb_target_group": {
      "api": {
        "name": "${var.name_prefix}-api",
        "port": "${var.api_port}",
        "protocol": "HTTPS",
        "target_type": "ip",
        "vpc_id": "${var.vpc_id}",
        "deregistration_delay": 30,
        "health_check": [
          {
            "protocol": "HTTPS",
            "path": "${var.api_health_path}",
            "matcher": "200",
            "interval": 15,
            "healthy_threshold": 2,
            "unhealthy_threshold": 3
          }
        ]
      },
      "keycloak": {
        "name": "${var.name_prefix}-keycloak",
        "port": "${var.keycloak_port}",
        "protocol": "HTTPS",
        "target_type": "ip",
        "vpc_id": "${var.vpc_id}",
        "deregistration_delay": 30,
        "health_check": [
          {
            "protocol": "HTTPS",
            "port": "${var.keycloak_management_port}",
            "path": "/health/ready",
            "matcher": "200",
            "interval": 15,
            "healthy_threshold": 2,
            "unhealthy_threshold": 3
          }
        ]
      }
    },
    "aws_lb_listener": {
      "https": {
        "//": "The only listener. There is deliberately no port 80 listener, not even a redirect.",
        "load_balancer_arn": "${aws_lb.edge.arn}",
        "port": 443,
        "protocol": "HTTPS",
        "ssl_policy": "ELBSecurityPolicy-TLS13-1-2-FIPS-2023-04",
        "certificate_arn": "${var.certificate_arn}",
        "routing_http_response_strict_transport_security_header_value": "max-age=31536000; includeSubDomains",
        "routing_http_response_server_enabled": false,
        "default_action": [
          {
            "type": "forward",
            "target_group_arn": "${aws_lb_target_group.api.arn}"
          }
        ],
        "lifecycle": [
          {
            "precondition": [
              {
                "condition": "${startswith(var.certificate_arn, \"arn:${data.aws_partition.current.partition}:acm:${var.region}:\")}",
                "error_message": "certificate_arn must be an ACM certificate in this partition and region."
              }
            ]
          }
        ]
      }
    },
    "aws_lb_listener_rule": {
      "deny_admin": {
        "//": "Keycloak admin console and admin REST API are never reachable from the internet.",
        "listener_arn": "${aws_lb_listener.https.arn}",
        "priority": 1,
        "condition": [{ "path_pattern": [{ "values": ["/admin", "/admin/*"] }] }],
        "action": [
          {
            "type": "fixed-response",
            "fixed_response": [{ "content_type": "text/plain", "message_body": "Not Found", "status_code": "404" }]
          }
        ]
      },
      "deny_master_realm": {
        "listener_arn": "${aws_lb_listener.https.arn}",
        "priority": 2,
        "condition": [{ "path_pattern": [{ "values": ["/realms/master", "/realms/master/*"] }] }],
        "action": [
          {
            "type": "fixed-response",
            "fixed_response": [{ "content_type": "text/plain", "message_body": "Not Found", "status_code": "404" }]
          }
        ]
      },
      "deny_traversal": {
        "//": "Dot segments and encoded dots or slashes could walk out of an allowed prefix into the admin paths.",
        "listener_arn": "${aws_lb_listener.https.arn}",
        "priority": 3,
        "condition": [{ "path_pattern": [{ "values": ["*..*", "*%2e*", "*%2E*", "*%2f*", "*%2F*"] }] }],
        "action": [
          {
            "type": "fixed-response",
            "fixed_response": [{ "content_type": "text/plain", "message_body": "Not Found", "status_code": "404" }]
          }
        ]
      },
      "keycloak_realm": {
        "listener_arn": "${aws_lb_listener.https.arn}",
        "priority": 10,
        "condition": [{ "path_pattern": [{ "values": ["/realms/signin-reports/*"] }] }],
        "action": [{ "type": "forward", "target_group_arn": "${aws_lb_target_group.keycloak.arn}" }]
      },
      "keycloak_resources": {
        "listener_arn": "${aws_lb_listener.https.arn}",
        "priority": 20,
        "condition": [{ "path_pattern": [{ "values": ["/resources/*"] }] }],
        "action": [{ "type": "forward", "target_group_arn": "${aws_lb_target_group.keycloak.arn}" }]
      },
      "deny_other_realms": {
        "//": "Any other realm (fake-entra is local only) is answered at the edge rather than by the api.",
        "listener_arn": "${aws_lb_listener.https.arn}",
        "priority": 30,
        "condition": [{ "path_pattern": [{ "values": ["/realms", "/realms/*"] }] }],
        "action": [
          {
            "type": "fixed-response",
            "fixed_response": [{ "content_type": "text/plain", "message_body": "Not Found", "status_code": "404" }]
          }
        ]
      }
    }
  }
}
