{
  "data": {
    "aws_iam_policy_document": {
      "audit_mirror_protection": {
        "statement": [
          {
            "sid": "DenyAuditMirrorDeletionOrShortening",
            "effect": "Deny",
            "actions": [
              "logs:DeleteLogGroup",
              "logs:DeleteLogStream",
              "logs:DeleteRetentionPolicy",
              "logs:PutRetentionPolicy",
              "logs:DisassociateKmsKey"
            ],
            "resources": [
              "${aws_cloudwatch_log_group.audit_mirror.arn}",
              "${aws_cloudwatch_log_group.audit_mirror.arn}:*"
            ]
          },
          {
            "sid": "DenyDisablingTheMirrorKey",
            "effect": "Deny",
            "actions": ["kms:ScheduleKeyDeletion", "kms:DisableKey"],
            "resources": ["${aws_kms_key.monitoring.arn}"]
          }
        ]
      }
    }
  },
  "resource": {
    "aws_iam_policy": {
      "audit_mirror_protection": {
        "name": "signin-reports-audit-mirror-protection",
        "description": "Denies deleting the 400-day audit mirror, shortening its retention or disabling its key",
        "policy": "${data.aws_iam_policy_document.audit_mirror_protection.json}"
      }
    },
    "aws_iam_role_policy_attachment": {
      "audit_mirror_protection": {
        "for_each": "${toset(var.audit_mirror_protected_role_names)}",
        "role": "${each.value}",
        "policy_arn": "${aws_iam_policy.audit_mirror_protection.arn}"
      }
    }
  }
}
