{
  "data": {
    "aws_iam_policy_document": {
      "monitoring_key": {
        "statement": [
          {
            "sid": "AccountAdministers",
            "effect": "Allow",
            "principals": [
              {
                "type": "AWS",
                "identifiers": [
                  "arn:${data.aws_partition.current.partition}:iam::${data.aws_caller_identity.current.account_id}:root"
                ]
              }
            ],
            "actions": ["kms:*"],
            "resources": ["*"]
          },
          {
            "sid": "CloudWatchLogsEncryptsSigninReportsGroups",
            "effect": "Allow",
            "principals": [
              { "type": "Service", "identifiers": ["logs.${data.aws_region.current.name}.amazonaws.com"] }
            ],
            "actions": ["kms:Encrypt", "kms:Decrypt", "kms:ReEncrypt*", "kms:GenerateDataKey*", "kms:DescribeKey"],
            "resources": ["*"],
            "condition": [
              {
                "test": "ArnLike",
                "variable": "kms:EncryptionContext:aws:logs:arn",
                "values": [
                  "arn:${data.aws_partition.current.partition}:logs:${data.aws_region.current.name}:${data.aws_caller_identity.current.account_id}:log-group:/signin-reports/*"
                ]
              }
            ]
          },
          {
            "sid": "CloudWatchAlarmsPublishToEncryptedTopic",
            "effect": "Allow",
            "principals": [{ "type": "Service", "identifiers": ["cloudwatch.amazonaws.com"] }],
            "actions": ["kms:Decrypt", "kms:GenerateDataKey*"],
            "resources": ["*"],
            "condition": [
              {
                "test": "StringEquals",
                "variable": "aws:SourceAccount",
                "values": ["${data.aws_caller_identity.current.account_id}"]
              }
            ]
          }
        ]
      }
    }
  },
  "resource": {
    "aws_kms_key": {
      "monitoring": {
        "description": "CMK for signin-reports log groups, the audit mirror and the alarm topic (CMP-11)",
        "enable_key_rotation": true,
        "deletion_window_in_days": 30,
        "policy": "${data.aws_iam_policy_document.monitoring_key.json}"
      }
    },
    "aws_kms_alias": {
      "monitoring": {
        "name": "alias/signin-reports-monitoring",
        "target_key_id": "${aws_kms_key.monitoring.key_id}"
      }
    }
  }
}
