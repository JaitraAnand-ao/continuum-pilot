      "lastName": "Admin",
      "attributes": {
        "tid": ["4f1b2c3d-5e6f-4a7b-8c9d-0e1f2a3b4c5d"],
        "oid": ["0b6a1c52-3d4e-4f60-8a71-92b3c4d5e603"]
      },
      "credentials": [{ "type": "password", "value": "${FAKE_ENTRA_USER_PASSWORD}", "temporary": false }],
      "clientRoles": { "signin-reports-broker": ["SignInReports.Admin"] }
    },
    {
      "username": "outsider",
      "enabled": true,
      "email": "outsider@contoso.test",
      "emailVerified": true,
      "firstName": "Oakley",
      "lastName": "Outsider",
      "attributes": {
        "tid": ["4f1b2c3d-5e6f-4a7b-8c9d-0e1f2a3b4c5d"],
        "oid": ["0b6a1c52-3d4e-4f60-8a71-92b3c4d5e604"]
      },
      "credentials": [{ "type": "password", "value": "${FAKE_ENTRA_USER_PASSWORD}", "temporary": false }],
      "clientRoles": { "signin-reports-broker": [] }
    },
    {
      "username": "other-tenant",
      "enabled": true,
      "email": "reader@fabrikam.test",
      "emailVerified": true,
      "firstName": "Frankie",
      "lastName": "Foreign",
      "attributes": {
        "tid": ["9e8d7c6b-5a49-4382-9170-6f5e4d3c2b1a"],
        "oid": ["0b6a1c52-3d4e-4f60-8a71-92b3c4d5e605"]
      },
      "credentials": [{ "type": "password", "value": "${FAKE_ENTRA_USER_PASSWORD}", "temporary": false }],
      "clientRoles": { "signin-reports-broker": ["SignInReports.Reader"] }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\":\"ENABLED\",\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[]}"
          ]
        }
      }
    ]
  }
}
