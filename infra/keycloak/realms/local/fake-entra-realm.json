{
  "realm": "fake-entra",
  "displayName": "Fake Entra ID (local and test only)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "client": {
      "signin-reports-broker": [
        {
          "name": "SignInReports.Admin",
          "description": "Entra app role: report administrator",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "SignInReports.Reader",
          "description": "Entra app role: reader group",
          "composite": false,
          "clientRole": true
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "signin-reports-broker",
      "name": "Entra Sign-In Reports (app registration stand-in)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${FAKE_ENTRA_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": ["${SR_PUBLIC_ORIGIN}/realms/signin-reports/broker/entra/endpoint"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${SR_PUBLIC_ORIGIN}/*"
      },
      "defaultClientScopes": ["basic", "profile", "email"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "oid",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "user.attribute": "id",
            "claim.name": "oid"
          }
        },
        {
          "name": "tid",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "user.attribute": "tid",
            "claim.name": "tid"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "usermodel.clientRoleMapping.clientId": "signin-reports-broker",
            "claim.name": "roles",
            "multivalued": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "reader@fake-entra.test",
      "email": "reader@fake-entra.test",
      "emailVerified": true,
      "firstName": "Reader",
      "lastName": "Test",
      "enabled": true,
      "attributes": {
        "tid": ["${FAKE_ENTRA_TENANT_ID}"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${FAKE_ENTRA_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "clientRoles": {
        "signin-reports-broker": ["SignInReports.Reader"]
