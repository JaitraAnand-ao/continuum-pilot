# Local and CI values for the signin-reports realm placeholders: the entra broker points at the
# fake-entra realm in the same Keycloak. Secrets (ENTRA_CLIENT_SECRET, KEYCLOAK_BFF_CLIENT_SECRET,
# FAKE_ENTRA_USER_PASSWORD, the vault file) come from the gitignored .env, never from this file.
ENTRA_TENANT_ID=4f1b2c3d-5e6f-4a7b-8c9d-0e1f2a3b4c5d
KEYCLOAK_PUBLIC_ORIGIN=https://localhost:8443
ENTRA_ISSUER=https://localhost:8443/realms/fake-entra
ENTRA_AUTHORIZATION_URL=https://localhost:8443/realms/fake-entra/protocol/openid-connect/auth
ENTRA_TOKEN_URL=https://localhost:8443/realms/fake-entra/protocol/openid-connect/token
ENTRA_JWKS_URL=https://localhost:8443/realms/fake-entra/protocol/openid-connect/certs
ENTRA_LOGOUT_URL=https://localhost:8443/realms/fake-entra/protocol/openid-connect/logout
ENTRA_CLIENT_ID=signin-reports-broker
SR_PUBLIC_ORIGIN=https://localhost
