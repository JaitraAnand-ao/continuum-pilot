# Terraform templatefile for the Keycloak task environment in aws-us-gov (rendered by
# infra/platform). Entra ID for US Government lives at login.microsoftonline.us. The Entra and
# BFF client secrets are not here: they are Secrets Manager ARNs in the task definition.
ENTRA_TENANT_ID=${entra_tenant_id}
ENTRA_ISSUER=https://login.microsoftonline.us/${entra_tenant_id}/v2.0
ENTRA_AUTHORIZATION_URL=https://login.microsoftonline.us/${entra_tenant_id}/oauth2/v2.0/authorize
ENTRA_TOKEN_URL=https://login.microsoftonline.us/${entra_tenant_id}/oauth2/v2.0/token
ENTRA_JWKS_URL=https://login.microsoftonline.us/${entra_tenant_id}/discovery/v2.0/keys
ENTRA_LOGOUT_URL=https://login.microsoftonline.us/${entra_tenant_id}/oauth2/v2.0/logout
ENTRA_CLIENT_ID=${entra_client_id}
SR_PUBLIC_ORIGIN=${public_origin}
